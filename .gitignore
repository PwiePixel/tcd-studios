# Runtime data (database, setup token, local config, logs) is never committed
/data/*
!/data/.htaccess
!/data/.gitkeep
/app/data-dir.local
# Generated by the application on the server (tools/publish-all.php, run by installer.sh) - never committed,
# otherwise "git pull" on the server stops with "local changes would be overwritten"
/sitemap.xml
/legal/*
!/legal/.gitkeep
# Written by installer.sh on the server
/.htaccess
