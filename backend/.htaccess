# Nothing in this directory may be requested directly; api.php (one level up)
# includes these files from the filesystem, which is not affected by this rule.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
